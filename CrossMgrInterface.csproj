<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- What a local build reports. release.yml passes -p:Version from the tag,
         which replaces this, so only a release ever shows a real version. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <!-- Screenshots for the in-application help. Generated, not hand-made: see
       HelpScreenshotTests and the Help screenshots section of CLAUDE.md. -->
  <ItemGroup>
    <EmbeddedResource Include="help_images\*.png" LogicalName="help_images/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The two real races the demos replay, names hidden: see DemoScenarios. -->
  <ItemGroup>
    <EmbeddedResource Include="demo_data\*.txt" LogicalName="demo_data/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The screenshot scenes open dialogs at a given step, which is not public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CrossMgrInterface.Tests" />
  </ItemGroup>

  <!-- The project sits at the repo root, so the default **/*.cs glob would
       otherwise swallow the test project's sources. -->
  <ItemGroup>
    <Compile Remove="CrossMgrInterface.Tests/**" />
    <None Remove="CrossMgrInterface.Tests/**" />
  </ItemGroup>

</Project>